# Django Environment Variables Template
# Copy to .env and adjust values for local development.

# Set to True for local development, False in production
DEBUG=True

# Django Secret Key (required when DEBUG=False)
SECRET_KEY=django-insecure-local-development-only

# Database connection URL (PostgreSQL)
# Local Postgres example: postgresql://postgres:postgres@localhost:5432/doctorsHub
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/doctorsHub

# Comma-separated list of allowed host header values
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of origins allowed to make CORS requests (used when DEBUG=False)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated list of trusted origins for CSRF
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
