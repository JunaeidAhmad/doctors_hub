# ==============================================================================
# Doctors Hub Frontend Environment Configuration
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# FOR LOCAL DEVELOPMENT:
# ---------------------
# Leaving this unset or setting to local backend:
VITE_API_BASE_URL=http://localhost:8000/api

# ==============================================================================
# FOR VERCEL (CLOUD DEPLOYMENT):
# ------------------------------
# Set this in your Vercel Project Settings -> "Environment Variables":
#
# VITE_API_BASE_URL=https://doctors-hub.onrender.com/api
# (Replace "doctors-hub.onrender.com" with your actual Render service hostname)
# ==============================================================================
